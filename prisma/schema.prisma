generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Settings {
  id               Int      @id @default(1)
  startingBankroll Float    @default(1000000)
  currency         String   @default("TZS")
  taxRate          Float    @default(0.12)
  emailEnabled     Boolean  @default(true)
  alertEmail       String   @default("nathanielmwaipopo@gmail.com")
  updatedAt        DateTime @updatedAt
}

model BetSlip {
  id          String   @id @default(cuid())
  date        DateTime
  strategy    String
  stake       Float
  totalOdds   Float
  grossPayout Float
  taxPaid     Float    @default(0)
  netProfit   Float    @default(0)
  netReturn   Float    @default(0)
  status      String   @default("Pending")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  legs        BetLeg[]
}

model BetLeg {
  id        String  @id @default(cuid())
  betSlipId String
  matchName String
  market    String
  odds      Float
  betSlip   BetSlip @relation(fields: [betSlipId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id        String   @id @default(cuid())
  eventKey  String
  stage     String
  subject   String?
  sentAt    DateTime @default(now())

  @@unique([eventKey, stage])
  @@index([sentAt])
}

model DigestLog {
  id              String   @id @default(cuid())
  digestDate      String   // YYYY-MM-DD in Africa/Nairobi
  qualifyingCount Int      @default(0)
  sent            Boolean  @default(false)
  statusMessage   String
  createdAt       DateTime @default(now())

  @@unique([digestDate])
  @@index([createdAt])
}
